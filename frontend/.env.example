# API base URL for the FastAPI backend (already set as a Cloudflare Worker
# var in wrangler.jsonc for production; only needed here for local dev).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Places API (New) key used to pull live Google reviews onto the
# homepage (see lib/google-reviews.ts). Without it, the homepage reviews
# section silently falls back to the static reviews in lib/content.ts.
#
# Setup:
# 1. In Google Cloud Console, enable "Places API (New)" on a project.
# 2. Create an API key, and restrict it to Places API (New) only.
# 3. Local dev: put it in a .env.local file (not committed) as below.
# 4. Production (Cloudflare Workers): run
#      npx wrangler secret put GOOGLE_PLACES_API_KEY
#    instead of adding it to wrangler.jsonc, since that file is committed
#    and its "vars" block isn't for secrets.
GOOGLE_PLACES_API_KEY=
